<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WallpaperSwitch.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootLayout">
        <Grid RowDefinitions="Auto,*">
            <Grid x:Name="AppTitleBar" Height="48">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10" Margin="16,0,0,0">
                    <Image x:Name="TitleBarIcon" Width="16" Height="16"/>
                    <TextBlock x:Uid="TitleBarAppName"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" AutomationProperties.AutomationId="SettingsScrollViewer">
                <StackPanel MaxWidth="760" Padding="36,4,36,40" Spacing="4" HorizontalAlignment="Stretch">
                    <InfoBar
                        x:Name="StatusInfoBar"
                        IsOpen="False"
                        IsClosable="True"
                        Margin="0,0,0,12"/>

                    <Border
                        Padding="20"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Margin="0,0,0,8">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                            <Border
                                Width="56"
                                Height="56"
                                CornerRadius="28"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                VerticalAlignment="Center">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <BitmapIcon
                                        x:Name="ModeIcon"
                                        Width="28"
                                        Height="28"
                                        ShowAsMonochrome="True"
                                        UriSource="ms-appx:///Assets/UiIcons/Dawn.png"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                    <FontIcon
                                        x:Name="ModeNightIcon"
                                        Glyph="&#xE708;"
                                        FontSize="26"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock x:Uid="ModeTitle"
                                    x:Name="ModeTitle"
                                    AutomationProperties.AutomationId="ModeTitle"
                                    TextWrapping="Wrap"
                                    Style="{StaticResource SubtitleTextBlockStyle}"/>
                                <TextBlock
                                    x:Name="ModeSubtitle"
                                    Text=""
                                    Opacity="0.72"
                                    TextWrapping="Wrap"/>
                                <TextBlock
                                    x:Name="SunTimesText"
                                    TextWrapping="Wrap"
                                    Opacity="0.72"
                                    Visibility="Collapsed"/>
                            </StackPanel>
                            <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button x:Uid="ApplyNowButton"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="ApplyNow_Click">
                                    <Button.ContentTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/></DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>
                                <Button x:Uid="PreviewToggleButton"
                                    x:Name="PreviewToggleButton"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    Click="PreviewOtherMode_Click">
                                    <Button.ContentTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/></DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <TextBlock x:Uid="SectionGeneral" Style="{StaticResource SectionHeaderStyle}" Margin="4,8,0,8"/>

                    <controls:SettingsCard x:Uid="AutoSwitchCard">
                        <controls:SettingsCard.HeaderIcon>
                            <BitmapIcon
                                Width="24"
                                Height="24"
                                ShowAsMonochrome="True"
                                UriSource="ms-appx:///Assets/UiIcons/AutoSwitch.png"/>
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Uid="EnabledToggle" x:Name="EnabledToggle" Toggled="SettingToggled"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Uid="StartupCard">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7E8;"/>
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Uid="StartupToggle" x:Name="StartupToggle" AutomationProperties.AutomationId="StartupToggle" Toggled="StartupToggle_Toggled"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Uid="HighPriorityStartupCard"
                        x:Name="HighPriorityStartupCard">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE83D;"/>
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Uid="HighPriorityStartupToggle" x:Name="HighPriorityStartupToggle" AutomationProperties.AutomationId="HighPriorityStartupToggle" Toggled="StartupToggle_Toggled"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Uid="TrayCard">
                        <controls:SettingsCard.HeaderIcon>
                            <BitmapIcon
                                Width="24"
                                Height="24"
                                ShowAsMonochrome="True"
                                UriSource="ms-appx:///Assets/UiIcons/TrayMinimize.png"/>
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Uid="TrayToggle" x:Name="TrayToggle" Toggled="SettingToggled"/>
                    </controls:SettingsCard>

                    <TextBlock x:Uid="SectionSchedule" Style="{StaticResource SectionHeaderStyle}"/>

                    <controls:SettingsCard x:Uid="ScheduleCard">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE787;"/>
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox
                            x:Name="ScheduleCombo"
                            MinWidth="180"
                            SelectionChanged="ScheduleCombo_SelectionChanged">
                            <ComboBoxItem x:Uid="ScheduleCustom"/>
                            <ComboBoxItem x:Uid="ScheduleSunrise"/>
                        </ComboBox>
                    </controls:SettingsCard>

                    <StackPanel x:Name="CustomTimesPanel" Spacing="4">
                        <controls:SettingsCard x:Uid="DawnStartCard">
                            <TimePicker x:Name="DawnTimePicker" ClockIdentifier="24HourClock" MinuteIncrement="1" SelectedTimeChanged="ScheduleTimeChanged"/>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="DayStartCard">
                            <TimePicker x:Name="DayTimePicker" ClockIdentifier="24HourClock" MinuteIncrement="1" SelectedTimeChanged="ScheduleTimeChanged"/>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="DuskStartCard">
                            <TimePicker x:Name="DuskTimePicker" ClockIdentifier="24HourClock" MinuteIncrement="1" SelectedTimeChanged="ScheduleTimeChanged"/>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="NightStartCard">
                            <TimePicker x:Name="NightTimePicker" ClockIdentifier="24HourClock" MinuteIncrement="1" SelectedTimeChanged="ScheduleTimeChanged"/>
                        </controls:SettingsCard>
                    </StackPanel>

                    <StackPanel x:Name="SunrisePanel" Spacing="4" Visibility="Collapsed">
                        <controls:SettingsCard x:Uid="LocationCard"
                            x:Name="LocationCard">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE81D;"/>
                            </controls:SettingsCard.HeaderIcon>
                            <Button x:Uid="UseLocationButton" Click="UseLocation_Click"/>
                        </controls:SettingsCard>

                        <controls:SettingsCard x:Uid="AutoLocationCard"
                            x:Name="AutoLocationCard">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE895;"/>
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch x:Uid="AutoLocationToggle"
                                x:Name="AutoLocationToggle"
                                Toggled="AutoLocationToggle_Toggled"/>
                        </controls:SettingsCard>

                        <controls:SettingsCard x:Uid="LocationFrequencyCard"
                            x:Name="LocationFrequencyCard">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE787;"/>
                            </controls:SettingsCard.HeaderIcon>
                            <ComboBox
                                x:Name="LocationFrequencyCombo"
                                MinWidth="150"
                                SelectionChanged="LocationFrequencyCombo_SelectionChanged">
                                <ComboBoxItem x:Uid="LocationHourly"/>
                                <ComboBoxItem x:Uid="LocationEvery12Hours"/>
                                <ComboBoxItem x:Uid="LocationDaily"/>
                                <ComboBoxItem x:Uid="LocationWeekly"/>
                                <ComboBoxItem x:Uid="LocationMonthly"/>
                            </ComboBox>
                        </controls:SettingsCard>
                    </StackPanel>

                    <TextBlock x:Uid="SectionAppearance" Style="{StaticResource SectionHeaderStyle}"/>

                    <controls:SettingsCard x:Uid="DesktopWallpaperCard">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE91B;"/>
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Uid="WallpaperToggle" x:Name="WallpaperToggle" Toggled="SettingToggled"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Uid="LockScreenCard">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xEE3F;"/>
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Uid="LockScreenToggle" x:Name="LockScreenToggle" Toggled="SettingToggled"/>
                    </controls:SettingsCard>

                    <controls:SettingsExpander x:Uid="DawnExpander" x:Name="DawnExpander">
                        <controls:SettingsExpander.HeaderIcon>
                            <BitmapIcon
                                Width="24"
                                Height="24"
                                ShowAsMonochrome="True"
                                UriSource="ms-appx:///Assets/UiIcons/Dawn.png"/>
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard x:Uid="ThemeModeCard">
                                <ComboBox x:Name="DawnThemeCombo" MinWidth="120" SelectionChanged="PeriodThemeChanged">
                                    <ComboBoxItem x:Uid="ThemeLight"/>
                                    <ComboBoxItem x:Uid="ThemeDark"/>
                                </ComboBox>
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Uid="PeriodWallpaperCard">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="96" Height="60" CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <Grid>
                                            <TextBlock x:Uid="DawnPlaceholder" x:Name="DawnPlaceholder" Opacity="0.55" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image x:Name="DawnPreview" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>
                                    <Button x:Uid="PickWallpaperButton" Click="PickDawnWallpaper_Click" VerticalAlignment="Center"/>
                                </StackPanel>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander x:Uid="DayExpander" x:Name="DayExpander">
                        <controls:SettingsExpander.HeaderIcon>
                            <BitmapIcon
                                Width="24"
                                Height="24"
                                ShowAsMonochrome="True"
                                UriSource="ms-appx:///Assets/UiIcons/Day.png"/>
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard x:Uid="ThemeModeCard">
                                <ComboBox x:Name="DayThemeCombo" MinWidth="120" SelectionChanged="PeriodThemeChanged">
                                    <ComboBoxItem x:Uid="ThemeLight"/>
                                    <ComboBoxItem x:Uid="ThemeDark"/>
                                </ComboBox>
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Uid="PeriodWallpaperCard">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="96" Height="60" CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <Grid>
                                            <TextBlock x:Uid="DayPlaceholder" x:Name="DayPlaceholder" Opacity="0.55" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image x:Name="DayPreview" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>
                                    <Button x:Uid="PickWallpaperButton" Click="PickDayWallpaper_Click" VerticalAlignment="Center"/>
                                </StackPanel>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander x:Uid="DuskExpander" x:Name="DuskExpander">
                        <controls:SettingsExpander.HeaderIcon>
                            <BitmapIcon
                                Width="24"
                                Height="24"
                                ShowAsMonochrome="True"
                                UriSource="ms-appx:///Assets/UiIcons/Dusk.png"/>
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard x:Uid="ThemeModeCard">
                                <ComboBox x:Name="DuskThemeCombo" MinWidth="120" SelectionChanged="PeriodThemeChanged">
                                    <ComboBoxItem x:Uid="ThemeLight"/>
                                    <ComboBoxItem x:Uid="ThemeDark"/>
                                </ComboBox>
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Uid="PeriodWallpaperCard">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="96" Height="60" CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <Grid>
                                            <TextBlock x:Uid="DuskPlaceholder" x:Name="DuskPlaceholder" Opacity="0.55" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image x:Name="DuskPreview" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>
                                    <Button x:Uid="PickWallpaperButton" Click="PickDuskWallpaper_Click" VerticalAlignment="Center"/>
                                </StackPanel>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander x:Uid="NightExpander" x:Name="NightExpander">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE708;"/>
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard x:Uid="ThemeModeCard">
                                <ComboBox x:Name="NightThemeCombo" MinWidth="120" SelectionChanged="PeriodThemeChanged">
                                    <ComboBoxItem x:Uid="ThemeLight"/>
                                    <ComboBoxItem x:Uid="ThemeDark"/>
                                </ComboBox>
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Uid="PeriodWallpaperCard">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="96" Height="60" CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <Grid>
                                            <TextBlock x:Uid="NightPlaceholder" x:Name="NightPlaceholder" Opacity="0.55" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image x:Name="NightPreview" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>
                                    <Button x:Uid="PickWallpaperButton" Click="PickNightWallpaper_Click" VerticalAlignment="Center"/>
                                </StackPanel>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <controls:SettingsCard x:Uid="WallpaperFitCard">
                        <ComboBox
                            x:Name="FitCombo"
                            MinWidth="140"
                            SelectionChanged="FitCombo_SelectionChanged">
                            <ComboBoxItem x:Uid="WallpaperFill"/>
                            <ComboBoxItem x:Uid="WallpaperFit"/>
                            <ComboBoxItem x:Uid="WallpaperStretch"/>
                            <ComboBoxItem x:Uid="WallpaperCenter"/>
                            <ComboBoxItem x:Uid="WallpaperSpan"/>
                            <ComboBoxItem x:Uid="WallpaperTile"/>
                        </ComboBox>
                    </controls:SettingsCard>

                    <TextBlock x:Uid="SectionWindowsColors" Style="{StaticResource SectionHeaderStyle}"/>

                    <controls:SettingsCard x:Uid="AppThemeCard">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE771;"/>
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Uid="AppThemeToggle" x:Name="AppThemeToggle" Toggled="SettingToggled"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Uid="SystemThemeCard">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE770;"/>
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Uid="SystemThemeToggle" x:Name="SystemThemeToggle" Toggled="SettingToggled"/>
                    </controls:SettingsCard>

                    <TextBlock x:Uid="SectionLanguage" Style="{StaticResource SectionHeaderStyle}"/>

                    <controls:SettingsCard x:Uid="LanguageCard">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE774;"/>
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox
                            x:Uid="LanguageCombo"
                            x:Name="LanguageCombo"
                            AutomationProperties.AutomationId="LanguageCombo"
                            DisplayMemberPath="DisplayName"
                            SelectedValuePath="Tag"
                            MinWidth="200"
                            SelectionChanged="LanguageCombo_SelectionChanged"/>
                    </controls:SettingsCard>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
